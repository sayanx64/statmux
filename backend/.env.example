# Get these from Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Secret header token required by POST /api/internal/refresh-all and /api/internal/send-digests
CRON_SECRET=your-secure-cron-secret-here

# Resend API key for transactional emails (welcome + weekly digest)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender address (must match a verified domain in your Resend account)
RESEND_FROM=statmux <statmux@sayan.cyou>

# Public frontend base URL
FRONTEND_URL=https://statmux.sayan.cyou

# Optional: GitHub Personal Access Token (increases rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=your-github-token-here

# Server Port
PORT=3001
